APP_NAME=Laravel
APP_ENV=local
APP_KEY=
DATA_HASH_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jayapura

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SUMMARY_LOGIN_URL=https://summary.timurbersinar.com/api/login
SUMMARY_LOGIN_TIMEOUT=15

MOBILE_TOKEN_EXPIRATION_DAYS=30
MOBILE_ANDROID_LATEST_VERSION=1.0.0
MOBILE_ANDROID_LATEST_BUILD=1
MOBILE_ANDROID_MINIMUM_VERSION=1.0.0
MOBILE_ANDROID_MINIMUM_BUILD=1
MOBILE_ANDROID_DISTRIBUTION_URL=
MOBILE_MAINTENANCE_ENABLED=false
MOBILE_MAINTENANCE_MESSAGE=
MOBILE_NOTIFICATION_RETENTION_DAYS=180
MOBILE_DELIVERY_RETENTION_DAYS=30
MOBILE_DEVICE_STALE_DAYS=90

FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Opt in only when the server is prepared for high-volume learning telemetry.
LEARNING_DETAILED_TRACKING_ENABLED=false
