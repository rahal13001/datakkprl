{"nodes": [{"id": "docs_kkprl_map_scale_inset_spec_skala_cetak_dan_inset_lokasi_bab_1", "label": "Skala cetak dan inset lokasi Bab 1", "file_type": "document", "source_file": "docs/kkprl-map-scale-inset-spec.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic"}, {"id": "docs_kkprl_map_scale_inset_spec_physical_print_dimensions", "label": "Physical print dimensions shared by Word and PDF", "file_type": "rationale", "source_file": "docs/kkprl-map-scale-inset-spec.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "The printed scale depends on the common physical image/frame width rather than screenshot pixels; Word/PDF must render that width identically."}, {"id": "docs_kkprl_map_scale_inset_spec_automatic_print_scale_denominator", "label": "Automatic conventional print scale denominator", "file_type": "rationale", "source_file": "docs/kkprl-map-scale-inset-spec.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Choose the smallest allowed denominator at or above 500 that fits the original site and margins; scale is presentation, not a legal precision claim."}, {"id": "docs_kkprl_map_scale_inset_spec_geometry_unchanged_by_zoom", "label": "Original application geometry unchanged by zoom", "file_type": "rationale", "source_file": "docs/kkprl-map-scale-inset-spec.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Changing distances on paper must not buffer, shift, enlarge or rewrite the original application geometry or measured area/length."}, {"id": "docs_kkprl_map_scale_inset_spec_web_mercator_centre_scale", "label": "Web Mercator ground scale at map centre", "file_type": "rationale", "source_file": "docs/kkprl-map-scale-inset-spec.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "WGS84/Web Mercator scale refers to the map centre and original print size; projection distortion and coordinate precision remain explicit."}, {"id": "docs_kkprl_map_scale_inset_spec_wider_worldcover_context_inset", "label": "Wider WorldCover context inset", "file_type": "rationale", "source_file": "docs/kkprl-map-scale-inset-spec.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Use coarse annual WorldCover imagery only in a wider inset, avoiding misleading satellite magnification at the detailed main-plan scale."}, {"id": "docs_kkprl_map_scale_inset_spec_inset_extent_not_application_boundary", "label": "Inset extent is not the application boundary", "file_type": "rationale", "source_file": "docs/kkprl-map-scale-inset-spec.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "The extent rectangle describes the main-map viewport; original geometry and a centre locator identify a tiny site without changing its area."}, {"id": "docs_kkprl_map_scale_inset_spec_versioned_scale_inset_snapshot", "label": "Versioned scale and inset snapshot", "file_type": "rationale", "source_file": "docs/kkprl-map-scale-inset-spec.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "A new layout version captures printed-map behavior while reconstructing older map/layout/null snapshots with historical metadata and hashes."}, {"id": "docs_kkprl_map_scale_inset_spec_bounded_public_tiles_private_documents", "label": "Bounded public tiles and private documents retained", "file_type": "rationale", "source_file": "docs/kkprl-map-scale-inset-spec.md", "source_loca