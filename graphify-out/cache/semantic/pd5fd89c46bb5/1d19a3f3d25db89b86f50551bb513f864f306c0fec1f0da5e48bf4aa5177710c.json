{"nodes": [{"id": "docs_decisions_adr_026_kepemilikan_dan_transisi_akses_pemohon_adr_026_kepemilikan_dan_transisi_akses_pemohon", "label": "ADR 026 Kepemilikan dan transisi akses pemohon", "file_type": "document", "source_file": "docs/decisions/ADR-026-kepemilikan-dan-transisi-akses-pemohon.md", "source_location": "L1", "_origin": "semantic", "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "Accepted on code 2026-10-07; migration/seeder/deployment not run on user database"}, {"id": "docs_decisions_adr_026_kepemilikan_dan_transisi_akses_pemohon_owner_backend_dan_legacy_nullable", "label": "Owner backend dan legacy nullable", "file_type": "rationale", "source_file": "docs/decisions/ADR-026-kepemilikan-dan-transisi-akses-pemohon.md", "source_location": "L13", "_origin": "semantic", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Additive tables/account audit/FK applicant_id nullable preserve legacy rows/chat/docs/attachments/history/encryption/snapshot. New drafts bind guard owner, not input. Legacy stays inaccessible to applicants until audited manual verified family assignment."}, {"id": "docs_decisions_adr_026_kepemilikan_dan_transisi_akses_pemohon_revisi_mewarisi_owner_root", "label": "Revisi mewarisi owner root", "file_type": "rationale", "source_file": "docs/decisions/ADR-026-kepemilikan-dan-transisi-akses-pemohon.md", "source_location": "L15", "_origin": "semantic", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Root and entire revision family locked for atomic assignment; conflicting owner rejected, encrypted reason/reference audit retained. Metadata assignment does not mutate payload/status/updated_at/snapshot. Future revisions inherit root applicant_id."}, {"id": "docs_decisions_adr_026_kepemilikan_dan_transisi_akses_pemohon_canreaddocuments_tanpa_approval_builder", "label": "canReadDocuments tanpa approval builder", "file_type": "rationale", "source_file": "docs/decisions/ADR-026-kepemilikan-dan-transisi-akses-pemohon.md", "source_location": "L17", "_origin": "semantic", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner and fresh session permit reading valid generated docs without approval. Pending portal only exposes document id/chapter/format/time after binary/private-disk/snapshot/manifest integrity checks; raw proposal/chat/attachments/progress not sent."}, {"id": "docs_decisions_adr_026_kepemilikan_dan_transisi_akses_pemohon_checkpoint_persistence_setelah_ai_gmrt_pdf", "label": "Checkpoint persistence setelah AI GMRT PDF", "file_type": "rationale", "source_file": "docs/decisions/ADR-026-kepemilikan-dan-transisi-akses-pemohon.md", "source_location": "L17", "_origin": "semantic", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builder checks fresh account/session version/approval/owner on hydration/actions/services. AI/GMRT authorization precedes request; components recheck owner/lock/checkpoint before persistence. Rendering occurs before final transaction checkpoint; revocation/reset prevents generated and failed writes."}, {"id": "docs_decisions_adr_026_kepemilikan_dan_transisi_akses_pemohon_signed_upload_terikat_akun_proposal_versi_sesi", "label": "Signed upload terikat akun proposal versi sesi", "file_type": "rationale", "source_file": "docs/decisions/ADR-026-kepemilikan-dan-transisi-akses-pemohon.md", "source_location": "L19", "_origin": "semantic", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WithKkprlFileUploads issues signed route keyed to applicant/proposal/session_version with Livewire expiry/throttle. Handler validates signature then locks proposal/account and checks approval/owner/lock/version at file receipt; other modules upload routes unchanged."}, {"id": "docs_decisions_adr_026_kepemilikan_dan_transisi_akses_pemohon_legacy_tiket_hp_fail_closed", "label": "Legacy tiket HP fail closed", "file_type": "rationale", "source_file": "docs/decisions/ADR-026-kepemilikan-dan-transisi-akses-pemohon.md", "source_location": "L21", "_origin": "semantic", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Start/resume routes redirect to login/account portal. Ticket/phone verifier, resume service and legacy submit action deny. kkprl_proposal_access never grants authority; selected proposal requires fresh approved owner."}, {"id": "docs_decisions_adr_026_kepemilikan_dan_transisi_akses_pemohon_snapshot_independen_metadata_akun_owner", "label": "Snapshot independen metadata akun owner", "file_type": "rationale", "source_file": "docs/decisions/ADR-026-kepemilikan-dan-transisi-akses-pemohon.md", "source_location": "L21", "_origin": "semantic", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Changing account approval/password/email or assigning owner does not invalidate generated docs; account metadata excluded from snapshot identity. Content, private storage, lock, manifest and hash checks remain."}, {"id": "docs_decisions_adr_026_kepemilikan_dan_transisi_akses_pemohon_runbook_migration_backup_tanpa_klaim_otomatis", "label": "Runbook migration backup tanpa klaim otomatis", "file_type": "rationale", "source_file": "docs/decisions/ADR-026-kepemilikan-dan-transisi-akses-pemohon.md", "source_location": "L29", "_origin": "semantic", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Before future authorized deployment backup DB/private artifacts, apply additive migration and specific KkprlApplicantPermissionSeeder; verify three agreed roles. No migrate:fresh or bulk/reset seeder; no down after new accounts/audit/ownership without recovery plan preserving new data. Isolated tests only exercise down/up."}], "edges": [{"source": "docs_decisions_adr_026_kepemilikan_dan_transisi_akses_pemohon_adr_026_kepemi