{"nodes": [{"id": "docs_decisions_adr_009_kkprl_renderer_and_private_artifacts_adr_009_snapshot_renderer_and_private_artifacts", "label": "ADR-009 Snapshot renderer and private artifacts", "file_type": "document", "source_file": "docs/decisions/ADR-009-kkprl-renderer-and-private-artifacts.md", "source_location": "line 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "summary": "Accepted MVP implementation decision dated 2026-08-24: encrypted snapshot/manifest, minimal OOXML DOCX and DomPDF PDF, private artifact storage.", "rationale": "Both formats must reflect the same draft state without publicly exposing files or requiring unavailable DOCX converters.", "status": "Accepted for MVP implementation; legacy local-disk compatibility is superseded by ADR-016", "evidence_scope": "Documented product/architecture decision; does not independently verify current code", "decision_location": "line 19", "_origin": "semantic"}, {"id": "docs_decisions_adr_009_kkprl_renderer_and_private_artifacts_encrypted_snapshot_and_manifest_artifact_identity", "label": "Encrypted snapshot and manifest artifact identity", "file_type": "rationale", "source_file": "docs/decisions/ADR-009-kkprl-renderer-and-private-artifacts.md", "source_location": "line 19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "summary": "KkprlProposalSnapshotService produces encrypted payload/manifest; hashes identify artifacts shared by DOCX/PDF.", "rationale": "Both outputs and their evidence need the same immutable source state.", "_origin": "semantic"}, {"id": "docs_decisions_adr_009_kkprl_renderer_and_private_artifacts_minimal_ooxml_and_dompdf_rendering", "label": "Minimal OOXML and DomPDF rendering", "file_type": "rationale", "source_file": "docs/decisions/ADR-009-kkprl-renderer-and-private-artifacts.md", "source_location": "line 22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "summary": "DOCX uses minimal OOXML internal media; PDF uses semantically same view; tables over four columns use landscape in both formats.", "rationale": "Avoid an unavailable external DOCX converter while preserving meaningful layout.", "_origin": "semantic"}, {"id": "docs_decisions_adr_009_kkprl_renderer_and_private_artifacts_visual_pdf_renderer_fail_closed", "label": "Visual PDF renderer fail-closed", "file_type": "rationale", "source_file": "docs/decisions/ADR-009-kkprl-renderer-and-private-artifacts.md", "source_location": "line 25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "summary": "Poppler PNG or legacy BMP normalized to PNG; visual PDFs require successful renderer and cannot become successful placeholders; original WebP stays unchanged.", "rationale": "Missing visual evidence must be reported as failed output rather than hidden degradation.", "_origin": "semantic"}, {"id": "docs_decisions_adr_009_kkprl_renderer_and_private_artifacts_kkprl_private_authorized_artifact_storage", "label": "kkprl_private authorized artifact storage", "file_type": "rationale", "source_file": "docs/decisions/ADR-009-kkprl-renderer-and-private-artifacts.md", "source_location": "line 28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "summary": "New files on separate kkprl_private disk with serve=false; scoped proposal session or Shield permissions authorize download.", "rationale": "Applicant attachments and generated documents must not become public storage assets.", "_origin": "semantic"}], "edges": [{"source": "docs_decisions_adr_009_kkprl_renderer_and_private_artifacts_adr_009_snapshot_renderer_and_private_artifacts", "target": "docs_decisions_adr_009_kkprl_renderer_and_private_artifacts_encrypted_snapshot_and_manifest_artifact_identity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-009-kkprl-renderer-and-private-artifacts.md", "source_location": "line 19", "weight": 1.0, "_or