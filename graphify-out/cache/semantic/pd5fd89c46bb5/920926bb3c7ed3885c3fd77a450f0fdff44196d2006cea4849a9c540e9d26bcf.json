{"nodes": [{"id": "docs_kkprl_map_scale_inset_spec_skala_cetak_dan_inset_lokasi_bab_1", "label": "Skala cetak dan inset lokasi Bab 1", "file_type": "document", "source_file": "docs/kkprl-map-scale-inset-spec.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "community": 14, "community_name": "Proposal Document Rendering"}, {"id": "docs_kkprl_map_scale_inset_spec_physical_print_dimensions", "label": "Physical print dimensions shared by Word and PDF", "file_type": "rationale", "source_file": "docs/kkprl-map-scale-inset-spec.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "The printed scale depends on the common physical image/frame width rather than screenshot pixels; Word/PDF must render that width identically.", "community": 14, "community_name": "Proposal Document Rendering"}, {"id": "docs_kkprl_map_scale_inset_spec_automatic_print_scale_denominator", "label": "Automatic conventional print scale denominator", "file_type": "rationale", "source_file": "docs/kkprl-map-scale-inset-spec.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Choose the smallest allowed denominator at or above 500 that fits the original site and margins; scale is presentation, not a legal precision claim.", "community": 14, "community_name": "Proposal Document Rendering"}, {"id": "docs_kkprl_map_scale_inset_spec_geometry_unchanged_by_zoom", "label": "Original application geometry unchanged by zoom", "file_type": "rationale", "source_file": "docs/kkprl-map-scale-inset-spec.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Changing distances on paper must not buffer, shift, enlarge or rewrite the original application geometry or measur