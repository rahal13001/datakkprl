{"nodes": [{"id": "docs_kkprl_map_measurement_spec_ukuran_geometri_peta_bab_1", "label": "Ukuran geometri peta Bab 1", "file_type": "document", "source_file": "docs/kkprl-map-measurement-spec.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kkprl_map_measurement_spec_polygon_hectare_dan_line_kilometer_dengan_dua_desimal", "label": "Polygon hectare dan line kilometer dengan dua desimal", "file_type": "concept", "source_file": "docs/kkprl-map-measurement-spec.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Polygon has area in ha; line sums all segment distances in km; point has no area/length. m\u00b2 divided by 10000 and m divided by 1000."}, {"id": "docs_kkprl_map_measurement_spec_spherical_wgs84_radius_6371008_8_meter", "label": "Spherical WGS84 radius 6371008.8 meter", "file_type": "concept", "source_file": "docs/kkprl-map-measurement-spec.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Haversine segment lengths and a spherical-ring integral use the existing coordinates on a mean-radius sphere. Display precision is not survey accuracy."}, {"id": "docs_kkprl_map_measurement_spec_warning_selisih_berbasis_pembulatan_dua_desimal", "label": "Warning selisih berbasis pembulatan dua desimal", "file_type": "concept", "source_file": "docs/kkprl-map-measurement-spec.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compare only matching dimensions/units after rounding both values to hundredths; zeros are real values, while blank is not zero."}, {"id": "docs_kkprl_map_measurement_spec_koordinat_parsial_dan_polygon_invalid_tidak_menghasilkan_nilai_stale", "label": "Koordinat parsial dan polygon invalid tidak menghasilkan nilai stale", "file_type": "concept", "source_file": "docs/kkprl-map-measurement-spec.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Incomplete/nonfinite/out-of-range coordinates and crossing/degenerate rings suppress misleading estimates. Reverse/closed rings and short antimeridian differences are supported."}, {"id": "docs_kkprl_map_measurement_spec_pengukuran_frontend_informatif_tanpa_persist_atau_blocking", "label": "Pengukuran frontend informatif tanpa persist atau blocking", "file_type": "concept", "source_file": "docs/kkprl-map-measurement-spec.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Warnings do not block save/export/submit and do not overwrite the applicant dimension. No computed payload, snapshot, document data or new required field."}, {"id": "docs_kkprl_map_measurement_spec_batas_satu_ring_spherical_tanpa_validitas_survei_legal", "label": "Batas satu ring spherical tanpa validitas survei legal", "file_type": "concept", "source_file": "docs/kkprl-map-measurement-spec.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Approximate geometry only; no holes or multipolygons, ellipsoid survey or legal area claims. Existing authorization and backend validation remain intact."}, {"id": "docs_kkprl_map_measurement_spec_turf_area_primary_documentation", "label": "Turf area primary documentation", "file_type": "document", "source_file": "docs/kkprl-map-measurement-spec.md", "source_location": "L19", "source_url": "https://turfjs.org/docs/api/area", "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kkprl_map_measurement_spec_turf_spherical_ring_area_implementation", "label": "Turf spherical ring area implementation", "file_type": "document", "source_file": "docs/kkprl-map-measurement-spec.md", "source_location": "L19", "source_url": "https://github.com/Turfjs/turf/blob/master/packages/t